{
  "rewrites": [
    {
      "source": "/((?!robots.txt|sitemap.xml|favicon.svg|ads.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/rechner-embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        }
      ]
    }
  ]
}
